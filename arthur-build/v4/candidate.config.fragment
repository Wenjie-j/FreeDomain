# Candidate only: append to an isolated copy of the V3 OpenWrt build config,
# then run make defconfig and inspect the effective config and image manifest.
# No router write, sysupgrade or release approval is implied.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
# Compile the target backend package but keep it outside the image until the
# target firewall4, mwan3, NSS and recovery tests pass.
CONFIG_PACKAGE_arthur-singbox-firewall4-test=m
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
# mwan3 2.12.2 still invokes iptables. Pin the nft compatibility provider so
# firewall4 builds never resolve its virtual dependencies to legacy xtables.
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
# CONFIG_PACKAGE_iptables-zz-legacy is not set
# CONFIG_PACKAGE_ip6tables-zz-legacy is not set
CONFIG_PACKAGE_wpad-mesh-openssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_ATH11K_MEM_PROFILE_1G=y
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
# CONFIG_ATH11K_NSS_SUPPORT is not set

# Sing-box intentionally not enabled here: candidate packages feed is 1.14.0.
# The current 1.14.1 binary was compiled for the old Linux 4.4 firmware.
# Rebuild pinned 1.14.1 source for this V4 toolchain with the required tags;
# then validate the current custom UI, service and configuration migration.
