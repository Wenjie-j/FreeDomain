#!/bin/sh
# V4 target candidate. Package only after target fw4/NSS/mwan3 recovery tests.
set -u

STATE_DIR=/etc/sing-box/arthur
CANDIDATE="$STATE_DIR/firewall4-candidate.nft"
INCLUDE=/etc/nftables.d/90-arthur-singbox.nft
OWNER="$STATE_DIR/firewall4-owner.sha256"
LOCK=/var/lock/arthur-singbox-firewall4.lock
RULE_PREF=16666
MARK=0x66/0xff
TABLE=166
LOCKED=0

log() { logger -t sing-box-firewall4 "$*" 2>/dev/null || true; }
fail() { log "$*"; echo "sing-box-firewall4: $*" >&2; return 1; }

unlock() {
    [ "$LOCKED" -eq 1 ] || return 0
    rmdir "$LOCK" 2>/dev/null || true
    LOCKED=0
}

lock() {
    mkdir -p "${LOCK%/*}" || return 1
    mkdir "$LOCK" 2>/dev/null || return 1
    LOCKED=1
    trap 'unlock' EXIT
    trap 'fail "transaction interrupted; inspect owned state before retry"; exit 1' HUP INT TERM
}

digest() {
    value=$(sha256sum "$1" 2>/dev/null) || return 1
    printf '%s\n' "${value%% *}"
}

owned() {
    [ -f "$INCLUDE" ] && [ ! -L "$INCLUDE" ] || return 1
    [ -f "$OWNER" ] && [ ! -L "$OWNER" ] || return 1
    current=$(digest "$INCLUDE") || return 1
    IFS= read -r recorded < "$OWNER" || return 1
    [ "$current" = "$recorded" ]
}

candidate_order_valid() {
    awk '
        /^chain arthur_singbox_udp[[:space:]]*\{/ { chain = "udp"; next }
        /^chain arthur_singbox_tcp_dns[[:space:]]*\{/ { chain = "tcp"; next }
        /^}/ { chain = "" }
        chain == "udp" && /ip daddr \{ .*10\.0\.0\.0\/8.*192\.168\.0\.0\/16.*\} return/ { udp_private = NR }
        chain == "udp" && /^[[:space:]]*ip daddr [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+ return$/ { udp_endpoint = NR; udp_endpoint_count++ }
        chain == "udp" && /ip daddr @arthur_cn4 return/ { udp_cn = NR }
        chain == "udp" && /meta l4proto udp tproxy ip to :7895/ { udp_proxy = NR }
        chain == "tcp" && /ip daddr \{ .*10\.0\.0\.0\/8.*192\.168\.0\.0\/16.*\} return/ { tcp_private = NR }
        chain == "tcp" && /^[[:space:]]*ip daddr [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+ return$/ { tcp_endpoint = NR; tcp_endpoint_count++ }
        chain == "tcp" && /ip daddr @arthur_cn4 return/ { tcp_cn = NR }
        chain == "tcp" && /meta l4proto tcp redirect to :7892/ { tcp_proxy = NR }
        END {
            valid = udp_private && udp_endpoint_count == 1 && udp_cn && udp_proxy &&
                    tcp_private && tcp_endpoint_count == 1 && tcp_cn && tcp_proxy &&
                    udp_private < udp_endpoint && udp_endpoint < udp_cn && udp_cn < udp_proxy &&
                    tcp_private < tcp_endpoint && tcp_endpoint < tcp_cn && tcp_cn < tcp_proxy
            exit(valid ? 0 : 1)
        }
    ' "$CANDIDATE"
}

candidate_valid() {
    [ -f "$CANDIDATE" ] && [ ! -L "$CANDIDATE" ] || return 1
    size=$(wc -c < "$CANDIDATE" 2>/dev/null) || return 1
    [ "$size" -ge 100 ] && [ "$size" -le 2097152 ] || return 1
    grep -Fq 'set arthur_cn4' "$CANDIDATE" &&
    grep -Fq 'chain arthur_singbox_udp' "$CANDIDATE" &&
    grep -Fq 'chain arthur_singbox_tcp_dns' "$CANDIDATE" &&
    grep -Fq 'meta l4proto udp tproxy ip to :7895' "$CANDIDATE" &&
    grep -Fq 'meta mark set mark and 0xffffff00 xor 0x66' "$CANDIDATE" &&
    candidate_order_valid
}

route_state() {
    routes=$(ip -4 route show table "$TABLE" 2>/dev/null) || return 1
    clean=$(printf '%s\n' "$routes" | sed '/^[[:space:]]*$/d')
    [ -z "$clean" ] && { printf '%s\n' absent; return 0; }
    count=$(printf '%s\n' "$clean" | wc -l)
    [ "$count" -eq 1 ] || { printf '%s\n' foreign; return 0; }
    printf '%s\n' "$clean" | grep -Eq '^local default dev lo( scope host)?$' || {
        printf '%s\n' foreign; return 0;
    }
    printf '%s\n' present
}

rule_state() {
    rules=$(ip -4 rule show 2>/dev/null) || return 1
    matching=$(printf '%s\n' "$rules" | grep -E "^[[:space:]]*$RULE_PREF:[[:space:]]" || true)
    [ -z "$matching" ] && { printf '%s\n' absent; return 0; }
    count=$(printf '%s\n' "$matching" | wc -l)
    [ "$count" -eq 1 ] || { printf '%s\n' foreign; return 0; }
    printf '%s\n' "$matching" | grep -Eq "^[[:space:]]*$RULE_PREF:[[:space:]]+from all fwmark 0x66/0xff (lookup|table) $TABLE([[:space:]]|$)" || {
        printf '%s\n' foreign; return 0;
    }
    printf '%s\n' present
}

chains_present() {
    nft list chain inet fw4 arthur_singbox_udp >/dev/null 2>&1 &&
    nft list chain inet fw4 arthur_singbox_tcp_dns >/dev/null 2>&1
}

chains_absent() {
    ! nft list chain inet fw4 arthur_singbox_udp >/dev/null 2>&1 &&
    ! nft list chain inet fw4 arthur_singbox_tcp_dns >/dev/null 2>&1
}

stage_include() {
    [ ! -e "$INCLUDE" ] && [ ! -L "$INCLUDE" ] &&
    [ ! -e "$OWNER" ] && [ ! -L "$OWNER" ] || return 1
    mkdir -p "${INCLUDE%/*}" "$STATE_DIR" || return 1
    tmp="$INCLUDE.tmp.$$"
    owner_tmp="$OWNER.tmp.$$"
    cp "$CANDIDATE" "$tmp" || { rm -f "$tmp"; return 1; }
    chmod 0600 "$tmp" || { rm -f "$tmp"; return 1; }
    value=$(digest "$tmp") || { rm -f "$tmp"; return 1; }
    printf '%s\n' "$value" > "$owner_tmp" || { rm -f "$tmp" "$owner_tmp"; return 1; }
    chmod 0600 "$owner_tmp" || { rm -f "$tmp" "$owner_tmp"; return 1; }
    mv -f "$owner_tmp" "$OWNER" || { rm -f "$tmp" "$owner_tmp"; return 1; }
    mv -f "$tmp" "$INCLUDE" || { rm -f "$tmp" "$OWNER"; return 1; }
}

add_routing() {
    ip -4 route add local 0.0.0.0/0 dev lo table "$TABLE" || return 1
    ip -4 rule add pref "$RULE_PREF" fwmark "$MARK" table "$TABLE" || {
        ip -4 route del local 0.0.0.0/0 dev lo table "$TABLE" >/dev/null 2>&1 || true
        return 1
    }
}

remove_routing() {
    rs=$1
    ts=$2
    if [ "$rs" = present ]; then
        ip -4 rule del pref "$RULE_PREF" fwmark "$MARK" table "$TABLE" || return 1
    fi
    if [ "$ts" = present ]; then
        ip -4 route del local 0.0.0.0/0 dev lo table "$TABLE" || return 1
    fi
}

start_new() {
    candidate_valid || { fail 'candidate missing or invalid'; return 1; }
    rs=$(rule_state) || { fail 'cannot inspect policy rules'; return 1; }
    ts=$(route_state) || { fail 'cannot inspect routing table 166'; return 1; }
    [ "$rs" = absent ] && [ "$ts" = absent ] || {
        fail 'reserved policy routing is already in use'; return 1;
    }
    add_routing || { fail 'cannot install policy routing'; return 1; }
    if ! stage_include || ! fw4 check; then
        rm -f "$INCLUDE" "$OWNER"
        remove_routing present present >/dev/null 2>&1 || true
        fail 'candidate staging or fw4 check failed'
        return 1
    fi
    if ! fw4 reload || ! chains_present; then
        rm -f "$INCLUDE" "$OWNER"
        if fw4 reload && chains_absent; then
            remove_routing present present >/dev/null 2>&1 || true
        else
            fail 'firewall rollback failed; policy routing retained'
            return 1
        fi
        fail 'firewall activation failed and was rolled back'
        return 1
    fi
    log 'firewall4 proxy rules active; runtime traffic still requires validation'
}

reconcile() {
    owned || { fail 'owned include not found or changed'; return 1; }
    rs=$(rule_state) || { fail 'cannot inspect policy rules'; return 1; }
    ts=$(route_state) || { fail 'cannot inspect routing table 166'; return 1; }
    [ "$rs" != foreign ] && [ "$ts" != foreign ] || {
        fail 'foreign reserved routing detected'; return 1;
    }
    fw4 check || { fail 'fw4 check failed'; return 1; }
    added_rule=0
    added_route=0
    if [ "$ts" = absent ]; then
        ip -4 route add local 0.0.0.0/0 dev lo table "$TABLE" || return 1
        added_route=1
    fi
    if [ "$rs" = absent ]; then
        ip -4 rule add pref "$RULE_PREF" fwmark "$MARK" table "$TABLE" || {
            [ "$added_route" -eq 0 ] || ip -4 route del local 0.0.0.0/0 dev lo table "$TABLE" >/dev/null 2>&1
            return 1
        }
        added_rule=1
    fi
    fw4 reload && chains_present || {
        fail "reconciliation failed; acquired routing retained rule=$added_rule route=$added_route"
        return 1
    }
}

start() {
    if [ -e "$INCLUDE" ] || [ -L "$INCLUDE" ] || [ -e "$OWNER" ] || [ -L "$OWNER" ]; then
        reconcile
    else
        start_new
    fi
}

stop() {
    if [ ! -e "$INCLUDE" ] && [ ! -L "$INCLUDE" ] &&
       [ ! -e "$OWNER" ] && [ ! -L "$OWNER" ]; then
        rs=$(rule_state) || { fail 'cannot inspect policy rules'; return 1; }
        ts=$(route_state) || { fail 'cannot inspect routing table 166'; return 1; }
        if [ "$rs" = absent ] && [ "$ts" = absent ] && chains_absent; then
            log 'firewall4 proxy rules already stopped'
            return 0
        fi
        fail 'unowned proxy routing or chains remain; refusing cleanup'
        return 1
    fi
    owned || { fail 'refusing to remove unowned or changed include'; return 1; }
    rs=$(rule_state) || { fail 'cannot inspect policy rules'; return 1; }
    ts=$(route_state) || { fail 'cannot inspect routing table 166'; return 1; }
    [ "$rs" != foreign ] && [ "$ts" != foreign ] || {
        fail 'foreign reserved routing detected'; return 1;
    }
    backup="$STATE_DIR/firewall4-stop-backup.$$"
    cp "$INCLUDE" "$backup" || return 1
    rm -f "$INCLUDE" || { rm -f "$backup"; return 1; }
    if ! fw4 reload || ! chains_absent; then
        mv -f "$backup" "$INCLUDE" || true
        fw4 reload >/dev/null 2>&1 || true
        fail 'firewall stop failed; include restored and routing retained'
        return 1
    fi
    rm -f "$backup"
    remove_routing "$rs" "$ts" || {
        fail 'firewall stopped but owned routing removal failed'; return 1;
    }
    rm -f "$OWNER" || { fail 'firewall stopped but owner cleanup failed'; return 1; }
    log 'firewall4 proxy rules stopped'
}

status() {
    owned && chains_present || return 1
    [ "$(rule_state)" = present ] && [ "$(route_state)" = present ]
}

case "${1:-}" in
    start) lock || { fail 'another firewall transaction is running'; exit 1; }; start ;;
    stop) lock || { fail 'another firewall transaction is running'; exit 1; }; stop ;;
    restart) lock || { fail 'another firewall transaction is running'; exit 1; }; stop && start_new ;;
    reconcile) lock || { fail 'another firewall transaction is running'; exit 1; }; reconcile ;;
    status) status ;;
    *) echo "usage: $0 {start|stop|restart|reconcile|status}" >&2; exit 2 ;;
esac
